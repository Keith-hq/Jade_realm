# ─────────────────────────────────────────────
# 复制为 .env 后填写。所有项都可留空：
#   图片 Key 留空 → 前端「⚙️ 设置」里填的 Key 生效；两者都空则生图会提示去配置。
#   文本 Key 留空 → 典故文本回落到内置模板，卡片仍可正常生成与分享。
# ─────────────────────────────────────────────

# 图片生成（SiliconFlow，OpenAI 兼容 images/generations 接口）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo

# 文本生成（任意 OpenAI 兼容 chat/completions 服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
